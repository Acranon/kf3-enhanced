<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>KingsFieldIII</AssemblyName>
        <RootNamespace>KingsFieldIII</RootNamespace>
        <!-- Tier-up can lose a MonoMod detour; Verdite2 measured it (docs/TODO.md there). -->
        <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="tools/RecompOne/RecompOne.Runtime/RecompOne.Runtime.csproj" />
    </ItemGroup>

    <!-- The vendored RecompOne comes in through the ProjectReference, and the release
         launcher and packaging are projects of their own: none is part of this glob. -->
    <ItemGroup>
        <Compile Remove="tools/**;auto/**;build/**;mods/**;launcher/**;packaging/**;dist/**;tests/**;research-archive/**" />
        <EmbeddedResource Remove="tools/**;auto/**;build/**;mods/**;launcher/**;packaging/**;dist/**;tests/**;research-archive/**" />
        <None Remove="tools/**;auto/**;build/**;mods/**;launcher/**;packaging/**;dist/**;tests/**;research-archive/**" />
    </ItemGroup>

</Project>
