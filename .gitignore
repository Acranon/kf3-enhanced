/disc/
/build/
/generated/
/auto/
/data/
/tests/saves/
*.kfstate
*.kfstate.bak
# The OCR's glyph templates are cut from the game's font.
/scripts/research/ocr/*.pkl
/scripts/research/ocr/tims_*/

